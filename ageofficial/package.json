{
  "name": "@r20sd/advanced-example-sheet",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sandbox-server": "vite --port 7620 --mode staging",
    "sandbox": "run-s build-scss sandbox-server",
    "build": "run-s build-scss build-only",
    "preview": "vite preview",
    "test:unit": "vitest --no-watch",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:local": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress run --e2e'",
    "test:e2e:open:local": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "build-scss": "sass ./src/rolltemplates/styles/host.scss ./public/host.css --no-source-map --no-charset",
    "watch-scss": "sass --watch ./src/rolltemplates/styles/host.scss ./public/host.css --no-source-map --no-charset",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "ci-check": "npm run format && npm run lint && npm run type-check && npm run test:unit && npm run test:e2e:local"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@popperjs/core": "^2.11.8",
    "@roll20-official/beacon-sdk": "^0.0.31",
    "@vueup/vue-quill": "^1.5.5",
    "bootstrap": "^5.3.9",
    "dompurify": "^3.4.17",
    "handlebars": "^4.7.10",
    "jsonpath": "^1.3.0",
    "lodash": "^4.18.1",
    "pinia": "^2.3.1",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue-component-library": "^0.0.8",
    "vue-i18n": "^11.4.19",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tippy": "^6.8.0",
    "vue2-editor": "^2.10.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@testing-library/vue": "^7.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/jsonpath": "^0.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^18.19.130",
    "@types/uuid": "^11.0.0",
    "@types/vue2-editor": "^2.6.5",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.1.3",
    "autoprefixer": "^10.6.2",
    "css-loader": "^7.1.5",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-vue": "^9.33.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^21.1.2",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^8.2.1",
    "prettier": "^2.8.8",
    "sass": "^1.108.2",
    "sass-loader": "^16.0.8",
    "start-server-and-test": "^2.1.5",
    "style-loader": "^4.0.0",
    "typescript": "~4.9.5",
    "vite": "^5.4.21",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^0.34.6",
    "vitest-dom": "^0.1.1",
    "vue-tsc": "^1.8.27",
    "webpack": "^5.112.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.7"
  }
}
