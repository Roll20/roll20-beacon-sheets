{
  "name": "chroniques-enyllion-beacon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sandbox-server": "vite --port 7620 --mode staging",
    "sandbox": "run-s build-scss sandbox-server",
    "build": "run-s build-scss && vite build",
    "build-scss": "sass ./src/rollTemplates/host.scss ./public/host.css --no-source-map --no-charset",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "@roll20-official/beacon-sdk": "0.0.13",
    "handlebars": "4.7.10",
    "uuid": "9.0.1",
    "lodash": "4.18.1",
    "jsonpath": "1.3.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "1.10.2",
    "@vitejs/plugin-vue": "5.0.4",
    "@vitejs/plugin-vue-jsx": "3.1.0",
    "@vue/eslint-config-prettier": "9.0.0",
    "npm-run-all": "4.1.5",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.24.1",
    "prettier": "3.2.5",
    "vite": "5.2.8",
    "vite-plugin-vue-devtools": "7.0.27",
    "sass": "1.75.0"
  }
}
