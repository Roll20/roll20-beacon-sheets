{
  "name": "phantasy-star-ttrpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s build-scss-dev dev-server",
    "dev-server": "vite",
    "sandbox-server": "vite --port 7620 --mode staging",
    "sandbox": "run-s build-scss-dev sandbox-server",
    "build": "run-s build-scss && vite build",
    "build-scss": "sass ./src/rollTemplates/host.scss ./public/host.css --no-source-map --no-charset",
    "build-scss-dev": "sass ./src/rollTemplates/host-dev.scss ./public/host.css --no-source-map --no-charset",
    "watch-scss": "sass --watch ./src/rollTemplates/host-dev.scss ./public/host.css --no-source-map --no-charset",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "node --test --test-reporter=spec \"src/**/*.test.js\""
  },
  "dependencies": {
    "@roll20-official/beacon-sdk": "^0.2.2",
    "handlebars": "^4.7.8",
    "lodash": "^4.17.21",
    "pinia": "^2.1.7",
    "uuid": "^9.0.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "sass": "^1.75.0",
    "vite": "^5.2.8",
    "vite-plugin-vue-devtools": "^7.0.25"
  }
}
