{
  "name": "@r20sd/advanced-example-sheet",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sandbox-server": "vite --port 7620 --mode staging",
    "sandbox": "run-s build-scss sandbox-server",
    "build": "run-s build-scss build-only",
    "preview": "vite preview",
    "test:unit": "vitest --no-watch",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:local": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress run --e2e'",
    "test:e2e:open:local": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "build-scss": "sass ./src/rolltemplates/styles/host.scss ./public/host.css --no-source-map --no-charset",
    "watch-scss": "sass --watch ./src/rolltemplates/styles/host.scss ./public/host.css --no-source-map --no-charset",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "ci-check": "npm run format && npm run lint && npm run type-check && npm run test:unit && npm run test:e2e:local",
    "schemas:generate": "tsx src/generate-schemas.mjs",
    "rake": "node src/compendium/rake.mjs src/compendium/entries src/compendium/rake.json"
  },
  "overrides": {
    "picomatch": "$picomatch",
    "@roll20-official/beacon-sdk": {
      "sanitize-html": "2.18.2"
    },
    "js-beautify": {
      "glob": "14.0.6"
    },
    "editorconfig": {
      "minimatch": "11.0.9"
    },
    "jsonpath": {
      "underscore": "1.13.8"
    }
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.3",
    "@roll20-official/beacon-sdk": "^0.2.3",
    "@sipec/vue3-tags-input": "^3.0.4",
    "dice-notation": "^0.0.3",
    "floating-vue": "^5.4.0",
    "handlebars": "^4.7.10",
    "jsonpath": "^1.3.0",
    "lodash": "^4.18.1",
    "mathjs": "^15.2.0",
    "pinia": "^4.1.0",
    "uuid": "^14.0.3",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.45",
    "vue-component-library": "^0.0.8",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@testing-library/vue": "^8.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/jsonpath": "^0.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.0.5",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "npm-run-all": "^4.1.5",
    "picomatch": "file:./patches/picomatch-4.0.8.tgz",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "start-server-and-test": "^3.0.13",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.0",
    "vitest-dom": "^0.1.1",
    "vue-tsc": "^3.3.14"
  }
}
