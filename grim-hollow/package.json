{
  "name": "@r20sd/advanced-example-sheet",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sandbox-server": "vite --port 7620 --mode staging",
    "sandbox": "run-s build-scss sandbox-server",
    "build": "run-s build-scss build-only",
    "preview": "vite preview",
    "test:unit": "vitest --no-watch",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:local": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress run --e2e'",
    "test:e2e:open:local": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "build-scss": "sass ./src/rolltemplates/styles/host.scss ./public/host.css --no-source-map --no-charset",
    "watch-scss": "sass --watch ./src/rolltemplates/styles/host.scss ./public/host.css --no-source-map --no-charset",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "ci-check": "npm run format && npm run lint && npm run type-check && npm run test:unit && npm run test:e2e:local",
    "schemas:generate": "tsx src/generate-schemas.mjs",
    "rake": "node src/compendium/rake.mjs src/compendium/entries src/compendium/rake.json"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "5.5.1",
    "@roll20-official/beacon-sdk": "0.0.13",
    "@sipec/vue3-tags-input": "3.0.4",
    "dice-notation": "0.0.3",
    "floating-vue": "5.2.2",
    "handlebars": "4.7.10",
    "jsonpath": "1.3.0",
    "lodash": "4.18.1",
    "mathjs": "14.5.3",
    "pinia": "2.1.7",
    "uuid": "9.0.1",
    "vite-svg-loader": "4.0.0",
    "vue": "3.4.15",
    "vue-component-library": "0.0.8",
    "vue-i18n": "11.4.14",
    "vue-router": "4.2.5",
    "zod": "3.25.71"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "1.7.0",
    "@testing-library/vue": "7.0.0",
    "@types/jsdom": "21.1.6",
    "@types/jsonpath": "0.2.4",
    "@types/lodash": "4.14.202",
    "@types/node": "18.19.8",
    "@types/uuid": "9.0.8",
    "@vitejs/plugin-vue": "4.6.2",
    "@vitest/coverage-c8": "0.33.0",
    "@vue/eslint-config-prettier": "7.1.0",
    "@vue/eslint-config-typescript": "11.0.3",
    "@vue/test-utils": "2.4.3",
    "@vue/tsconfig": "0.1.3",
    "cypress": "13.6.6",
    "eslint": "8.56.0",
    "eslint-plugin-cypress": "2.15.1",
    "eslint-plugin-vue": "9.20.1",
    "jsdom": "21.1.2",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.8",
    "sass": "1.70.0",
    "start-server-and-test": "2.0.3",
    "tsx": "4.20.5",
    "typescript": "4.8.4",
    "vite": "4.5.14",
    "vite-svg-loader": "4.0.0",
    "vitest": "0.31.4",
    "vitest-dom": "0.1.1",
    "vue-tsc": "1.8.27",
    "zod-to-json-schema": "3.24.6"
  }
}
